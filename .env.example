# Copy to .env.local for local dev. Set the real values in Vercel → Project → Settings → Environment Variables.
# Every variable here is server-only. None are prefixed NEXT_PUBLIC_, so none reach the browser.

# Public base URL of the deployment (used to build vote/results links and Whop redirect URLs)
APP_BASE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys). The publishable key (sb_publishable_...) can only call
# the public functions. The secret key (sb_secret_...) bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Whop (production account). Plan of the existing $5 PitchTest product.
WHOP_API_KEY=
WHOP_PLAN_ID=
# Webhook signing secret from Whop → Developer → Webhooks
WHOP_WEBHOOK_SECRET=

# Judge demo. TEST_MODE only takes effect when BOTH are set; the code must be entered on the order page.
TEST_MODE=false
DEMO_ACCESS_CODE=

# Salt for hashing voter identifiers (any long random string)
VOTER_HASH_SALT=

# Terac completion callback; participants are sent here after voting. Leave blank to disable.
TERAC_CALLBACK_URL=
